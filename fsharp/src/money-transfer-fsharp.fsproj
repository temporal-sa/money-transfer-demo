<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>MoneyTransfer</RootNamespace>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- F# compiles files in the order listed here. -->
  <ItemGroup>
    <Compile Include="Model.fs" />
    <Compile Include="Activities.fs" />
    <Compile Include="AccountTransferWorkflow.fs" />
    <Compile Include="AccountTransferWorkflowScenarios.fs" />
    <Compile Include="EncryptionCodec.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="Temporalio" Version="1.14.0" />
  </ItemGroup>

</Project>
